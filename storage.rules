rules_version = '2';

// Firebase Storage rules for the Stories bucket (gen-lang-client-0373200489.firebasestorage.app).
// The app reads pictures, audio and word timings and lists chapter folders (storageAssetLoader.ts),
// so reading is open. Nobody can write from a browser: files are uploaded in the Firebase
// console or by Cloud Build with its service account, which these rules do not restrict.
// This file is the source of truth; publish it with `firebase deploy --only storage`
// (see docs/OPERATIONS.md).
service firebase.storage {
  match /b/{bucket}/o {
    // Rules add up (one allow is enough), so a separate "deny" block cannot close a folder that a
    // catch-all opens. The folder is checked here instead: tts-state/ holds the build state of the
    // narration steps and is never public.
    match /{folder}/{rest=**} {
      allow get, list: if folder != 'tts-state';
      allow write: if false;
    }
    match /{file} {
      allow get, list: if true;
      allow write: if false;
    }
  }
}
