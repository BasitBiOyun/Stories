{
  "name": "stories-interactive-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "validate:a2": "tsx scripts/validation/validateA2Blueprints.ts",
    "validate:b1": "tsx scripts/validation/validateB1Blueprints.ts",
    "validate:b2": "tsx scripts/validation/validateB2Blueprints.ts && tsx scripts/validation/validateMeccaB2Gold.ts && tsx scripts/validation/validateMeccaB2GoldArabic.ts && tsx scripts/validation/validateYunusB2Gold.ts && tsx scripts/validation/validateB2GoldCrossBook.ts",
    "validate": "npm run validate:a2 && npm run validate:b1 && npm run validate:b2 && npm run typecheck",
    "validate:bundle": "tsx scripts/validation/validateBundle.ts",
    "canonical:generate": "tsx scripts/validation/canonicalContent.ts --write",
    "audit:media": "tsx scripts/validation/auditStorageMedia.ts",
    "diagnose:b2-highlight-pairs": "tsx scripts/validation/diagnoseB2HighlightPairs.ts",
    "pdf:adam-a2-gold": "node scripts/pdf-pilot/buildAdamA2EnglishGoldMaster.mjs",
    "pdf:b1-sample": "tsx scripts/pdf-pilot/buildB1ChapterSample.ts",
    "pdf:b2-sample": "tsx scripts/pdf-pilot/buildB2ChapterSample.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^10.9.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
