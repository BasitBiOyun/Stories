{
  "name": "stories-interactive-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run validate:learning-system && npm run validate:a2-highlight-aggregate && npm run validate:b1-highlight-aggregate && npm run validate:b2-highlight-aggregate && npm run validate:bilingual-highlight-cards && npm run validate:b1-rollout && npm run validate:story-language-lock",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "canonical:generate": "tsx scripts/validation/canonicalContent.ts --write",
    "validate:canonical": "tsx scripts/validation/canonicalContent.ts",
    "validate:content": "tsx scripts/validation/validateContent.ts",
    "validate:guides": "tsx scripts/validation/validateGuides.ts",
    "validate:story-language-lock": "tsx scripts/validation/validateStoryLanguageLock.ts",
    "validate:blueprint": "tsx scripts/validation/validateLearningBlueprintInfrastructure.ts",
    "validate:learning-system": "tsx scripts/validation/validateUnifiedLearningSystem.ts && npm run validate:blueprint",
    "audit:media": "tsx scripts/validation/auditStorageMedia.ts",
    "validate:a2-highlight-aggregate": "tsx scripts/validation/validateA2HighlightAggregate.ts",
    "validate:b1-highlight-aggregate": "tsx scripts/validation/validateB1HighlightAggregate.ts",
    "validate:b2-highlight-aggregate": "tsx scripts/validation/validateB2HighlightAggregate.ts",
    "validate:bilingual-highlight-cards": "tsx scripts/validation/validateBilingualHighlightCards.ts",
    "diagnose:b2-highlight-pairs": "tsx scripts/validation/diagnoseB2HighlightPairs.ts",
    "validate:adam-a2-learning": "tsx scripts/validation/validateAdamA2Learning.ts && tsx scripts/validation/validateAdamA2Blueprint.ts",
    "validate:a2-rollout": "tsx scripts/validation/validateA2Rollout.ts",
    "validate:b1-rollout": "tsx scripts/validation/validateB1Rollout.ts && tsx scripts/validation/validateB1Safety.ts",
    "validate:b2-pilot": "tsx scripts/validation/validateMosesB2GoldPilot.ts && tsx scripts/validation/validateMosesB2StudentGuide.ts && tsx scripts/validation/validateMosesB2GoldArabic.ts",
    "validate:b2-adam": "tsx scripts/validation/validateAdamB2Gold.ts && tsx scripts/validation/validateAdamB2GoldArabic.ts",
    "validate:b2-abraham": "tsx scripts/validation/validateAbrahamB2Gold.ts && tsx scripts/validation/validateAbrahamB2GoldArabic.ts",
    "validate:b2-mecca": "tsx scripts/validation/validateMeccaB2Gold.ts && tsx scripts/validation/validateMeccaB2GoldArabic.ts",
    "validate:b2-yunus": "tsx scripts/validation/validateYunusB2Gold.ts",
    "validate:b2-crossbook": "tsx scripts/validation/validateB2GoldCrossBook.ts",
    "validate:b2-rollout": "npm run validate:b2-pilot && npm run validate:b2-adam && npm run validate:b2-abraham && npm run validate:b2-mecca && npm run validate:b2-yunus && npm run validate:b2-crossbook",
    "validate": "npm run validate:learning-system && npm run validate:canonical && npm run validate:content && npm run validate:guides && npm run validate:story-language-lock && npm run validate:adam-a2-learning && npm run validate:a2-rollout && npm run validate:b1-rollout && npm run validate:b2-rollout && npm run validate:bilingual-highlight-cards",
    "quality": "npm run validate && npm run typecheck && npm run build && npm run validate:bundle",
    "validate:bundle": "tsx scripts/validation/validateBundle.ts",
    "pdf:adam-a2-gold": "node scripts/pdf-pilot/buildAdamA2EnglishGoldMaster.mjs",
    "pdf:b1-sample": "tsx scripts/pdf-pilot/buildB1ChapterSample.ts",
    "pdf:b2-sample": "tsx scripts/pdf-pilot/buildB2ChapterSample.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^10.9.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
